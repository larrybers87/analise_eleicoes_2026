# Dados brutos e intermediários (grandes, reproduzíveis pelo coletor)
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep
# Processados grandes (manter só os leves que o web/ consome)
data/processed/*.parquet
!data/processed/.gitkeep
# Seção/zona: dados grandes futuros (~470 mil seções, F4) — bloqueados por nome
# de arquivo em qualquer extensão (não só .parquet, que já cai no bloqueio
# acima: isso cobre também .csv, que não tem bloqueio geral em data/processed/)
data/processed/*secao*
data/processed/*zona*
# Parquet pequenos (nível município/UF/BR, ~1.3MB total em 05/10/2026) — ok versionar
!data/processed/presidente_t1_br.parquet
!data/processed/presidente_t1_br_totais.parquet
!data/processed/presidente_t1_uf.parquet
!data/processed/presidente_t1_uf_totais.parquet
!data/processed/presidente_t1_municipio.parquet
!data/processed/presidente_t1_municipio_totais.parquet

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.venv/

# SO / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code (config local pessoal não vai pro repo)
.claude/settings.local.json
